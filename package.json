{
  "name": "wynncraft-quicklaunch",
  "version": "2.2.0",
  "description": "Wynncraft Quicklaunch & Mineflayer Web Bot Controller with 3D Viewer & AI Insights",
  "main": "scripts/wynn_bot_server.js",
  "dependencies": {
    "mysql2": "^3.14.4"
  },
  "scripts": {
    "setup": "bash scripts/setup.sh",
    "start": "bash scripts/start_all.sh",
    "stop": "bash scripts/stop_all.sh",
    "bot": "node scripts/wynn_bot_server.js",
    "dashboard": "node scripts/wynn_bot_server.js",
    "textures": "python3 scripts/apply_wynn_textures.py",
    "mineflayer:check": "node scripts/mineflayer/check.mjs",
    "preflight": "bash scripts/preflight.sh --node",
    "db:init": "node scripts/mysql_setup.js",
    "db:backfill": "node scripts/mysql_backfill.js",
    "db:seed-prices": "node scripts/seed_tracked_prices.js",
    "db:backup:linux": "bash scripts/linux_mysql_backup.sh",
    "market:sync": "node scripts/daily_market_sync.js",
    "wynner": "bash scripts/wynner.sh",
    "test": "bash tests/run_all_tests.sh && bash scripts/check.sh",
    "postinstall": "cd mineflayer-wynn && npm ci --no-audit --no-fund"
  },
  "keywords": [
    "wynncraft",
    "mineflayer",
    "minecraft",
    "prism-launcher",
    "dashboard",
    "ai-insights"
  ],
  "license": "MIT"
}
